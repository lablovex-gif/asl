# AI API Keys Pool - System automatically switches between keys (Round-Robin & Failover):
# Option A: Numbered keys (e.g. 3 Gemini keys)
GEMINI_API_KEY_1="AIzaSy_YOUR_FIRST_KEY"
GEMINI_API_KEY_2="AIzaSy_YOUR_SECOND_KEY"
GEMINI_API_KEY_3="AIzaSy_YOUR_THIRD_KEY"

# Option B: Comma-separated list
# GEMINI_API_KEYS="key1,key2,key3"

# Standard fallback single key:
GEMINI_API_KEY="AIzaSy_YOUR_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"


