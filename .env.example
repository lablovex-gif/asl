# Pezeex Multi-Key Pool Configuration (Bytez & AI Keys)
# Switches between the 3 API keys automatically with Round-Robin per search:
# Search 1 -> Key 1
# Search 2 -> Key 2
# Search 3 -> Key 3
# Search 4 -> Key 1

# Option A: Bytez API keys (32 hex characters)
BYTEZ_API_KEY_1="your_bytez_api_key_1"
BYTEZ_API_KEY_2="your_bytez_api_key_2"
BYTEZ_API_KEY_3="your_bytez_api_key_3"

# Option B: Google Gemini API keys (AIzaSy...)
GEMINI_API_KEY_1="AIzaSy_YOUR_FIRST_KEY"
GEMINI_API_KEY_2="AIzaSy_YOUR_SECOND_KEY"
GEMINI_API_KEY_3="AIzaSy_YOUR_THIRD_KEY"

# Option C: General API Keys
API_KEY_1="your_api_key_1"
API_KEY_2="your_api_key_2"
API_KEY_3="your_api_key_3"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
